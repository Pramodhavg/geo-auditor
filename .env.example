# Required for the AI Visibility Probe (Check 1) and query generation.
OPENAI_API_KEY=sk-...

# Optional overrides
# OPENAI_MODEL=gpt-4.1-mini          # engine model (supports web_search, cheap)
# OPENAI_PROFILE_MODEL=gpt-4.1-mini  # model used to profile the business + write queries

# Optional: only if you use --engine perplexity (no reliable free tier)
# PERPLEXITY_API_KEY=pplx-...
# PERPLEXITY_MODEL=sonar
